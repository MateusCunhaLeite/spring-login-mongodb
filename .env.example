# Copie este arquivo para .env e preencha com os seus valores:
#   cp .env.example .env
# O .env está no .gitignore e NUNCA deve ser versionado.

# Connection string do MongoDB Atlas (Database > Connect > Drivers).
# O nome do banco vai depois da barra: .../login_seguro?...
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/login_seguro?retryWrites=true&w=majority

# Primeiro administrador (criado automaticamente na inicialização)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha-123

# Tema visual: default ou athena
APP_THEME=default

# Domínio permitido no cadastro (vazio = qualquer e-mail). Ex.: umc.br
APP_ALLOWED_DOMAIN=
